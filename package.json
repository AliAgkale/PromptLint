{
  "name": "promptlint-core",
  "version": "2.22.0",
  "description": "Algorithmic prompt analysis engine. No AI. Full build (nspell + tiktoken) and lite build (zero-deps) for Chrome extension.",
  "keywords": [
    "prompt",
    "linter",
    "spell-checker",
    "tokenizer",
    "llm",
    "gpt",
    "offline",
    "chrome-extension"
  ],
  "author": "PromptLint Contributors",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.full.js",
      "require": "./dist/index.full.cjs",
      "types": "./dist/index.full.d.ts"
    },
    "./full": {
      "import": "./dist/index.full.js",
      "require": "./dist/index.full.cjs",
      "types": "./dist/index.full.d.ts"
    },
    "./lite": {
      "import": "./dist/index.lite.js",
      "require": "./dist/index.lite.cjs",
      "types": "./dist/index.lite.d.ts"
    }
  },
  "main": "./dist/index.full.cjs",
  "module": "./dist/index.full.js",
  "types": "./dist/index.full.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:full": "tsup src/index.full.ts --format esm,cjs --dts --out-dir dist --clean",
    "build:lite": "tsup src/index.lite.ts --format esm,cjs --dts --out-dir dist",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "dictionary-en": "^4.0.0",
    "js-tiktoken": "^1.0.15",
    "nspell": "^2.1.5"
  },
  "devDependencies": {
    "@types/nspell": "^2.1.6",
    "@vitest/coverage-v8": "^1.6.0",
    "tsup": "^8.1.0",
    "tsx": "^4.23.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}